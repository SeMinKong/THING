# ============================================================================
# thing 내부망 관제·제어 웹
# ----------------------------------------------------------------------------
# 커밋되는 템플릿은 env.txt 이고, 실제 값이 담긴 .env 계열은 무시한다.
# 근거: FR-41 "토큰은 YAML·Git에 두지 않는다", NFR-20 내부망 제어 보안
# ============================================================================

# ── 환경변수 (실제 값) ──────────────────────────────────────────────────────
# backend/.env, frontend/.env.local 등. env.txt 는 커밋한다.
.env
.env.*
!.env.example
# frontend/.env 는 로컬 개발 기본값만 담고 있어 예외로 유지한다.
# 장비별 실제 주소는 frontend/.env.local 에 두고 커밋하지 않는다.
!web/frontend/.env

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/

# 로그
*.log
logs/

# ── Node / Vite ─────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ROS 2 빌드 산출물
build/
install/
log/

# ── 테스트 / 커버리지 ───────────────────────────────────────────────────────
coverage/
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.nyc_output/

# ── 에디터 / OS ─────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
